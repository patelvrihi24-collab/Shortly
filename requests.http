### 18 Login user 2 (stores token2, so user 1's token stays intact)
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{"email": "other@example.com", "password": "SuperSecret123"}

> {%
    client.test("login works", function () {
        client.assert(response.status === 200, "Got " + response.status);
    });
    client.global.set("token2", response.body.token);
%}

### 19 User 2 tries to delete user 1's link (expect 404)
DELETE http://localhost:8080/api/v1/urls/{{code}}
Authorization: Bearer {{token2}}

> {%
    client.test("cannot delete someone else's link", function () {
        client.assert(response.status === 404, "Got " + response.status);
    });
%}

### 20 User 2 asks for user 1's stats (expect 404)
GET http://localhost:8080/api/v1/urls/{{code}}/stats?days=7
Authorization: Bearer {{token2}}

> {%
    client.test("cannot read someone else's stats", function () {
        client.assert(response.status === 404, "Got " + response.status);
    });
%}

### 21 User 1 deletes the link (expect 204)
DELETE http://localhost:8080/api/v1/urls/{{code}}
Authorization: Bearer {{token}}

> {%
    client.test("deleted", function () {
        client.assert(response.status === 204, "Got " + response.status);
    });
%}

### 22 Redirect after delete (expect 404: the cache entry was evicted too)
# @no-redirect
GET http://localhost:8080/{{code}}

> {%
    client.test("deleted link is gone", function () {
        client.assert(response.status === 404, "Got " + response.status);
    });
%}

### 23 Link with a one-day expiry (stores expCode)
POST http://localhost:8080/api/v1/urls
Content-Type: application/json
Authorization: Bearer {{token}}

{"url": "https://example.com/expiry", "ttlDays": 1}

> {%
    client.test("expiry link created", function () {
        client.assert(response.status === 201, "Got " + response.status);
    });
    client.global.set("expCode", response.body.shortCode);
%}

### 24 Open the expiry link once so it gets cached (expect 302)
# @no-redirect
GET http://localhost:8080/{{expCode}}

> {%
    client.test("expiry link redirects", function () {
        client.assert(response.status === 302, "Got " + response.status);
    });
%}